# --- Core ---
JWT_SECRET=replace-with-a-long-random-string

# --- Database: leave both blank for local dev (uses a local SQLite file automatically). ---
# For production, create a free database at turso.tech, then fill these in:
TURSO_DATABASE_URL=your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=ey...

# --- Groq (free, no credit card): console.groq.com/keys ---
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
